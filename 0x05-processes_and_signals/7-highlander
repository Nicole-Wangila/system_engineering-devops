#!/usr/bin/env bash
# 7-highlander: prints "To infinity and beyond" indefinitely
# and reacts to SIGTERM by printing "I am invincible!!!" without terminating

# Trap SIGTERM and print the message
trap 'echo "I am invincible!!!"' SIGTERM

# Print at least once immediately
echo "To infinity and beyond"

# Infinite loop
while true; do
    sleep 2
    echo "To infinity and beyond"
done
