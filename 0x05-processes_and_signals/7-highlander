#!/usr/bin/env bash
# 7-highlander: prints "To infinity and beyond" indefinitely
# and reacts to SIGTERM by printing "I am invincible!!!" without terminating

# Function to handle SIGTERM
handle_sigterm() {
    echo "I am invincible!!!"
}

# Trap SIGTERM and call the function
trap 'handle_sigterm' SIGTERM

# Infinite loop
while true; do
    echo "To infinity and beyond"
    sleep 2
done




